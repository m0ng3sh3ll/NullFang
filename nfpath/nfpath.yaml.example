# nfpath configuration
# Copy to: ~/.nfpath/config.yaml  or  .nfpath.yaml (current directory)
# Flags always override this file.

llm:
  # --- Local (default, no key needed) ---
  url: http://localhost:11434
  model: qwen2.5:3b
  provider: ollama

  # --- OpenAI ---
  # url: https://api.openai.com
  # model: gpt-4o-mini
  # key: sk-...
  # provider: openai

  # --- Anthropic ---
  # url: https://api.anthropic.com
  # model: claude-haiku-4-5-20251001
  # key: sk-ant-...
  # provider: anthropic

  # --- Groq (fast, free tier) ---
  # url: https://api.groq.com/openai
  # model: llama-3.1-8b-instant
  # key: gsk_...
  # provider: openai

  # --- LiteLLM proxy (routes to anything) ---
  # url: http://localhost:4000
  # model: anthropic/claude-haiku-4-5-20251001
  # key: anything
  # provider: openai
